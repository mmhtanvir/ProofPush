# ProofPush Configuration
# Place this file as .proofpush.yml in your repository root

# Audit mode:
# - advisory: run audit, show findings, never block push
# - interactive: ask for developer approval if issues are found
# - strict: block push on regressions, secrets, or critical failures
mode: interactive

# Audit depth:
# - quick: targeted changed-route tests, fast security check, priority visual diffs
# - full: comprehensive route discovery, full workflow suite, multi-viewport tests
audit_level: quick

# Baseline strategy:
# - merge-base: on push to an existing branch, the commit live on that branch now; otherwise
#   the git merge base against reference_ref (recommended)
# - captured: compare against locally saved snapshot captured with `proofpush baseline capture`
# - commit: compare against explicit git revision
# - latest-passed: compare against the last commit that passed an audit (recorded automatically, newest 50 kept)
baseline:
  strategy: merge-base
  reference_ref: origin/main

# Application startup and lifecycle configuration:
application:
  type: custom # custom, nextjs, django, fastapi, node, static
  start_command: "python3 -m http.server $PORT"
  port: 3000
  health_check: "/"
  health_timeout: 30
  env:
    NODE_ENV: test
    TEST_MODE: "1"

# Routes to test
routes:
  auto_discover: true
  crawl: false      # true: log in and follow links to every reachable page
  max_pages: 50
  base_routes:
    - "/"
    - "/checkout"
  excluded_routes:
    - "/admin/purge*"

# Pre-defined functional workflows
workflows:
  - name: "Homepage to Checkout"
    path: "/"
    steps:
      - action: navigate
        value: "/"
      - action: click
        selector: "button[data-testid='buy-now']"
        optional: true
      - action: assert_url
        expected: "/checkout"

  # guard: true pins a previously fixed bug. If it fails, the push is flagged as a
  # regression even when the baseline fails too (e.g. a stale checkout undoing a fix).
  - name: "Coupon updates order total (bug fixed in #42)"
    path: "/checkout"
    guard: true
    steps:
      - action: fill
        selector: "#coupon"
        value: "SAVE10"
      - action: click
        selector: "#apply-btn"
      - action: assert_text
        selector: "#total"
        expected: "$90.00"

# Visual comparison settings
visual:
  enabled: true
  diff_threshold: 0.02
  viewports:
    - width: 1280
      height: 800
      name: desktop
    - width: 375
      height: 667
      name: mobile
  excluded_selectors:
    - ".timestamp"
    - ".dynamic-id"
    - "[data-dynamic]"

# Security checks
security:
  sensitive_paths:
    - ".env*"
    - "**/*.pem"
    - "**/*.key"
    - "credentials.json"
  fail_on_secret: true
  fail_on_unrelated: false

# AI assistance (optional, 100% works locally without external AI)
# Secrets are always redacted before anything is sent to a remote provider.
ai:
  provider: local # local, or openai (needs OPENAI_API_KEY)
  # model: gpt-4o-mini # openai only

# Enforcement policies
policies:
  fail_open: false
  interactive_fallback: block # block or allow in non-interactive / CI / AI CLI environments

# Test accounts (values are env var NAMES; put the secrets in your environment or .proofpush/secrets.env)
# auth:
#   login_path: /login
#   accounts:
#     local: {username_env: SHOP_USER, password_env: SHOP_PASSWORD}
#     prod:  {username_env: SHOP_PROD_USER, password_env: SHOP_PROD_PASSWORD, otp_secret_env: SHOP_PROD_OTP}

# Live sites for `proofpush check --env <name>` (read-only)
# environments:
#   prod: https://shop.example.com

# Suspicious-push rules
# push_rules:
#   disable: [py-obfuscated-payload]

# Keep the newest N report sets in .proofpush/reports (older reports and screenshots are deleted)
report_retention: 30

# Alerts for blocked pushes and failed checks
# notify:
#   desktop: true            # OS notification when nobody is at a terminal (GUI / AI agent pushes)
#   webhook_env: TEAM_WEBHOOK  # Slack / Discord / generic webhook URL, kept in .proofpush/secrets.env

# Click safe buttons in both versions: catch ones that stop working, slow down, get janky or vanish (opt-in)
# interactions:
#   auto_click: true
#   max_per_page: 8
#   max_pages: 10

# API payload tests: same requests to old and new version (see README "API Payload Testing")
# api_tests:
#   mode: affected            # off | smoke | affected | full
#   allow_writes: false
#   cases:
#     - {name: health, path: /api/health, prod: true, expect: {status: 200}}
