# Local Website Change Auditor Configuration
# Place this file as .change-auditor.yml in your repository root

# Audit mode:
# - advisory: run audit, show findings, never block push
# - interactive: ask for developer approval if issues are found
# - strict: block push on regressions, secrets, or critical failures
mode: interactive

# Audit depth:
# - quick: targeted changed-route tests, fast security check, priority visual diffs
# - full: comprehensive route discovery, full workflow suite, multi-viewport tests
audit_level: quick

# Baseline strategy:
# - merge-base: git merge base against remote ref or target branch (recommended)
# - captured: compare against locally saved snapshot captured with `change-auditor baseline capture`
# - commit: compare against explicit git revision
# - latest-passed: compare against latest commit that successfully passed audit
baseline:
  strategy: merge-base
  reference_ref: origin/main

# Application startup and lifecycle configuration:
application:
  type: custom # custom, nextjs, django, fastapi, node, static
  start_command: "python3 -m http.server $PORT"
  port: 3000
  health_check: "/"
  health_timeout: 30
  env:
    NODE_ENV: test
    TEST_MODE: "1"

# Routes to test
routes:
  auto_discover: true
  base_routes:
    - "/"
    - "/checkout"
  excluded_routes:
    - "/admin/purge*"

# Pre-defined functional workflows
workflows:
  - name: "Homepage to Checkout"
    path: "/"
    steps:
      - action: navigate
        value: "/"
      - action: click
        selector: "button[data-testid='buy-now']"
        optional: true
      - action: assert_url
        expected: "/checkout"

# Visual comparison settings
visual:
  enabled: true
  diff_threshold: 0.02
  viewports:
    - width: 1280
      height: 800
      name: desktop
    - width: 375
      height: 667
      name: mobile
  excluded_selectors:
    - ".timestamp"
    - ".dynamic-id"
    - "[data-dynamic]"

# Security checks
security:
  sensitive_paths:
    - ".env*"
    - "**/*.pem"
    - "**/*.key"
    - "credentials.json"
  fail_on_secret: true
  fail_on_unrelated: false

# AI assistance (optional, 100% works locally without external AI)
ai:
  provider: local # local, openai, anthropic
  model: gpt-4o-mini
  redact_before_send: true

# Enforcement policies
policies:
  fail_open: false
  interactive_fallback: block # block or allow in non-interactive / CI / AI CLI environments
